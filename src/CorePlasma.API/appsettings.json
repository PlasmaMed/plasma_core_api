{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Issuer": "CorePlasma",
    "Audience": "CorePlasma.Clients",
    "Secret": "",
    "ExpirationMinutes": 60,
    "RememberMeDays": 30
  },
  "ApiKey": {
    "Key": ""
  },
  "SuperAdmin": {
    "EmployeeCode": "ADMIN",
    "Username": "admin",
    "FullName": "Super Administrator",
    "Email": null,
    "Password": ""
  },
  "PermissionCache": {
    "ExpirationMinutes": 10
  },
  "LoginSecurity": {
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15
  },
  "Database": {
    "Provider": "PostgreSql",
    "ApplyMigrationsOnStartup": false,
    "SeedOnStartup": true
  },
  "Swagger": {
    "Enabled": false
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{CorrelationId}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/core-plasma-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{CorrelationId}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "AllowedHosts": "*",
  "IntegrationPeer": {
    "BaseUrl": ""
  }
}
